{
  "name": "jmv2gg-workbench",
  "version": "0.2.3",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node tools/prepare-runtime.mjs",
    "prebuild": "node tools/prepare-runtime.mjs",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "postbuild": "node tools/write-build-info.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run && npm run test:build-info",
    "test:build-info": "node tests/check-build-info.mjs",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "jszip": "^3.10.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "webr": "0.6.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
